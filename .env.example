# Copy to .env.local and fill in. Never commit .env.local.

# Base URL of the helpyoufindthat backend (see ../helpyoufindthat_backend).
VITE_API_BASE_URL=https://helpyoufindthat-backend.onrender.com

# Supabase project URL and publishable (anon) key — same project the backend
# uses. These are public client keys, safe to ship in the frontend bundle;
# access control is enforced by Postgres row-level security, not by keeping
# these secret. Used for real user sign-up/sign-in.
VITE_SUPABASE_URL=https://dgpfkozawvlghnodsldd.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_fi6nxrTimcrpia81jsPPcw_sbYl2zUS

# Optional: a static Supabase access token, used only as a fallback by
# src/app/lib/api.ts when no one is logged in through the UI (handy for
# testing the API directly). Expires ~1 hour after issue. Get a fresh one
# from the backend repo with:
#   npm run token -- you@example.com 'your-password'
VITE_API_TOKEN=
